{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "PowerShell|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/DGB/Project/NichirinLaserMark/.claude/hooks/guard-shell.ps1",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/DGB/Project/NichirinLaserMark/.claude/hooks/sync-memory.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
