{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/DGB/Project/computer-vision-app/.claude/hooks/guard-bash.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/DGB/Project/computer-vision-app/.claude/hooks/guard-edit.js",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/DGB/Project/computer-vision-app/.claude/hooks/sync-memory.js",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
